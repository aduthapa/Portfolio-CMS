<%- include('../partials/public-header') %>

<section class="container section">
  <div class="section-header">
    <h1>Talent</h1>
    <span class="muted"><%= total %> profile<%= total === 1 ? '' : 's' %></span>
  </div>

  <form method="get" action="/profiles" class="filter-bar">
    <input type="search" name="q" value="<%= q %>" placeholder="Search by name..." />
    <select name="category">
      <option value="">All categories</option>
      <% categoryOptions.forEach(function (c) { %>
        <option value="<%= c.value %>" <%= selectedCategory === c.value ? 'selected' : '' %>><%= c.label %></option>
      <% }) %>
    </select>
    <button class="btn btn-primary" type="submit">Filter</button>
    <% if (q || selectedCategory) { %><a class="btn btn-ghost" href="/profiles">Clear</a><% } %>
  </form>

  <% if (profiles.length === 0) { %>
    <p class="muted">No profiles matched your search.</p>
  <% } else { %>
  <div class="card-grid">
    <% profiles.forEach(function (p) { %>
      <a class="profile-card" href="/profiles/<%= p.slug %>">
        <div class="profile-card-media" style="<%= p.avatarUrl ? `background-image:url('${p.avatarUrl}')` : '' %>">
          <% if (!p.avatarUrl) { %><span class="profile-card-initials"><%= (p.stageName || p.fullName).slice(0,1) %></span><% } %>
          <% if (p.featured) { %><span class="badge badge-featured">Featured</span><% } %>
        </div>
        <div class="profile-card-body">
          <h3><%= p.stageName || p.fullName %></h3>
          <p class="muted"><%= p.shortBio || '' %></p>
        </div>
      </a>
    <% }) %>
  </div>
  <% } %>

  <%- include('../partials/pagination', {
    page: page, totalPages: totalPages, pageList: pageList, basePath: '/profiles',
    extraQuery: 'q=' + encodeURIComponent(q) + '&category=' + encodeURIComponent(selectedCategory)
  }) %>
</section>

<%- include('../partials/public-footer') %>
