<%- include('../partials/public-header') %>

<section class="hero">
  <div class="container hero-inner">
    <h1><%= settings.tagline || 'Welcome to my portfolio.' %></h1>
    <div class="hero-actions">
      <a class="btn btn-primary btn-lg" href="/contact">Get in touch</a>
    </div>
  </div>
</section>

<% if (blocks.length === 0) { %>
  <div class="container section empty-state">
    <p class="muted">This page hasn't been built yet.</p>
    <% if (currentUser) { %><a class="btn btn-primary" href="/admin/builder">Open the page builder &rarr;</a><% } %>
  </div>
<% } else { %>
  <% blocks.forEach(function (block) { %>
    <%- include('blocks/' + block.type.toLowerCase(), { block: block }) %>
  <% }) %>
<% } %>

<%- include('../partials/public-footer') %>
