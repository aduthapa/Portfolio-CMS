<%- include('../../partials/admin-header') %>

<div class="toolbar">
  <a class="btn btn-primary" href="/admin/users/new">+ Add team member</a>
</div>

<div class="panel">
  <table class="table">
    <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th></th></tr></thead>
    <tbody>
      <% users.forEach(function (u) { %>
      <tr>
        <td><a href="/admin/users/<%= u.id %>/edit"><strong><%= u.name %></strong></a><% if (u.id === currentUser.id) { %> <span class="badge badge-muted">You</span><% } %></td>
        <td><%= u.email %></td>
        <td><span class="badge badge-outline"><%= u.role %></span></td>
        <td><%- u.active ? '<span class="badge badge-published">Active</span>' : '<span class="badge badge-archived">Disabled</span>' %></td>
        <td class="table-actions">
          <a class="btn btn-sm btn-ghost" href="/admin/users/<%= u.id %>/edit">Edit</a>
          <% if (u.id !== currentUser.id) { %>
          <form method="post" action="/admin/users/<%= u.id %>?_method=DELETE" onsubmit="return confirm('Remove this team member?');">
            <button class="btn btn-sm btn-danger" type="submit">Delete</button>
          </form>
          <% } %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../../partials/admin-footer') %>
