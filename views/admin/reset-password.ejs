<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> — <%= settings.siteName %> Admin</title>
  <link rel="stylesheet" href="/css/base.css" />
  <link rel="stylesheet" href="/css/admin.css" />
  <style>:root { --brand: <%= settings.primaryColor %>; }</style>
</head>
<body class="auth-body">
  <main class="auth-card">
    <h1 class="auth-title">Reset password</h1>
    <p class="muted">Enter the 6-digit code we emailed you along with your new password.</p>
    <%- include('../partials/flash') %>
    <form method="post" action="/admin/reset-password" class="stack">
      <label class="field">
        <span>Email</span>
        <input type="email" name="email" required autocomplete="username" value="<%= email %>" />
      </label>
      <label class="field">
        <span>Reset code</span>
        <input type="text" name="code" required inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autofocus autocomplete="one-time-code" />
      </label>
      <label class="field">
        <span>New password</span>
        <input type="password" name="password" required minlength="8" autocomplete="new-password" />
      </label>
      <label class="field">
        <span>Confirm new password</span>
        <input type="password" name="confirmPassword" required minlength="8" autocomplete="new-password" />
      </label>
      <button class="btn btn-primary btn-block" type="submit">Reset password</button>
    </form>
    <div class="auth-links">
      <a href="/admin/forgot-password<%= email ? '?email=' + encodeURIComponent(email) : '' %>">Request a new code</a>
      <a href="/admin/login">Back to sign in</a>
    </div>
  </main>
</body>
</html>
