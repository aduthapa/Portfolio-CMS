<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> — <%= settings.siteName %> Admin</title>
  <link rel="stylesheet" href="/css/base.css" />
  <link rel="stylesheet" href="/css/admin.css" />
  <style>:root { --brand: <%= settings.primaryColor %>; }</style>
</head>
<body class="auth-body">
  <main class="auth-card">
    <h1 class="auth-title">Forgot password</h1>
    <p class="muted">Enter your account email and we'll send you a one-time code to reset your password.</p>
    <%- include('../partials/flash') %>
    <form method="post" action="/admin/forgot-password" class="stack">
      <label class="field">
        <span>Email</span>
        <input type="email" name="email" required autofocus autocomplete="username" value="<%= email %>" />
      </label>
      <button class="btn btn-primary btn-block" type="submit">Send reset code</button>
    </form>
    <div class="auth-links">
      <a href="/admin/reset-password<%= email ? '?email=' + encodeURIComponent(email) : '' %>">Already have a code?</a>
      <a href="/admin/login">Back to sign in</a>
    </div>
  </main>
</body>
</html>
