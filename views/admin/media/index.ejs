<%- include('../../partials/admin-header') %>

<div class="panel">
  <h2>Upload files</h2>
  <form method="post" action="/admin/media" enctype="multipart/form-data" class="inline-fields">
    <input type="file" name="files" accept="image/*,video/*" multiple required />
    <button class="btn btn-primary" type="submit">Upload</button>
  </form>
  <p class="muted small">Upload reusable images or videos here, then copy their URL for use elsewhere (e.g. site logo).</p>
</div>

<div class="panel">
  <h2>Library (<%= total %>)</h2>
  <% if (assets.length === 0) { %>
    <p class="muted">No files uploaded yet.</p>
  <% } else { %>
  <div class="media-grid">
    <% assets.forEach(function (a) { %>
    <div class="media-tile">
      <% if (a.mediaType === 'VIDEO') { %>
        <video src="<%= a.url %>" muted></video>
      <% } else { %>
        <img src="<%= a.url %>" alt="<%= a.fileName %>" />
      <% } %>
      <div class="media-tile-body">
        <input type="text" readonly value="<%= a.url %>" onclick="this.select()" />
        <form method="post" action="/admin/media/<%= a.id %>?_method=DELETE" onsubmit="return confirm('Delete this file?');">
          <button class="btn btn-sm btn-danger" type="submit">Delete</button>
        </form>
      </div>
    </div>
    <% }) %>
  </div>
  <% } %>
  <%- include('../../partials/pagination', { page: page, totalPages: totalPages, pageList: pageList, basePath: '/admin/media' }) %>
</div>

<%- include('../../partials/admin-footer') %>
