<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> — <%= settings.siteName %> Admin</title>
  <% if (settings.faviconUrl) { %><link rel="icon" href="<%= settings.faviconUrl %>" /><% } %>
  <link rel="stylesheet" href="/css/base.css" />
  <link rel="stylesheet" href="/css/admin.css" />
  <style>:root { --brand: <%= settings.primaryColor %>; }</style>
</head>
<body class="admin-body">
  <div class="loading-overlay" id="loadingOverlay">
    <span class="loading-overlay-brand"><%= settings.siteName %></span>
    <div class="loading-dots"><span></span><span></span><span></span></div>
  </div>
  <script>
    (function () {
      var ALREADY_SHOWN_KEY = "pcms_splash_shown";
      var overlay = document.getElementById("loadingOverlay");
      if (!overlay) return;
      if (sessionStorage.getItem(ALREADY_SHOWN_KEY)) {
        overlay.remove();
        return;
      }
      var MIN_DISPLAY_MS = 2000;
      var start = Date.now();
      function hideOverlay() {
        sessionStorage.setItem(ALREADY_SHOWN_KEY, "1");
        var wait = Math.max(0, MIN_DISPLAY_MS - (Date.now() - start));
        setTimeout(function () {
          overlay.classList.add("loading-overlay-hide");
          setTimeout(function () { overlay.remove(); }, 350);
        }, wait);
      }
      if (document.readyState === "complete") hideOverlay();
      else window.addEventListener("load", hideOverlay);
    })();
  </script>
  <div class="admin-shell">
    <aside class="admin-sidebar" id="adminSidebar">
      <a href="/admin" class="admin-brand"><%= settings.siteName %></a>
      <nav class="admin-nav">
        <a href="/admin" class="<%= currentPath === '/admin' || currentPath === '/admin/' ? 'active' : '' %>">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="2" width="7" height="7" rx="1.5"/><rect x="11" y="2" width="7" height="7" rx="1.5"/><rect x="2" y="11" width="7" height="7" rx="1.5"/><rect x="11" y="11" width="7" height="7" rx="1.5"/></svg>
          Dashboard
        </a>
        <a href="/admin/builder" class="<%= currentPath.startsWith('/admin/builder') ? 'active' : '' %>">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="2" width="16" height="4" rx="1"/><rect x="2" y="8" width="10" height="4" rx="1"/><rect x="2" y="14" width="13" height="4" rx="1"/></svg>
          Page builder
        </a>
        <a href="/admin/profiles" class="<%= currentPath.startsWith('/admin/profiles') ? 'active' : '' %>">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="10" cy="6.5" r="3.2"/><path d="M3.5 17c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/></svg>
          Profile
        </a>
        <a href="/admin/inquiries" class="<%= currentPath.startsWith('/admin/inquiries') ? 'active' : '' %>">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="4" width="16" height="12" rx="1.5"/><path d="M3 5.5l7 5.5 7-5.5"/></svg>
          Inquiries
        </a>
        <a href="/admin/media" class="<%= currentPath.startsWith('/admin/media') ? 'active' : '' %>">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="3" width="16" height="14" rx="1.5"/><circle cx="7" cy="8" r="1.6"/><path d="M3 15l4.5-4.5 3 3L15 8l3 3"/></svg>
          Media library
        </a>
        <a href="/admin/settings" class="<%= currentPath.startsWith('/admin/settings') ? 'active' : '' %>">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="10" cy="10" r="3"/><path d="M10 2v2.2M10 15.8V18M18 10h-2.2M4.2 10H2M15.6 4.4l-1.5 1.5M5.9 14.1l-1.5 1.5M15.6 15.6l-1.5-1.5M5.9 5.9L4.4 4.4"/></svg>
          Settings
        </a>
        <% if (currentUser && currentUser.role === 'ADMIN') { %>
        <a href="/admin/users" class="<%= currentPath.startsWith('/admin/users') ? 'active' : '' %>">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="7" cy="6.5" r="2.6"/><circle cx="14" cy="7.5" r="2.2"/><path d="M2 17c0-3 2.2-5 5-5s5 2 5 5M12.5 12.3c2.3.2 4 1.9 4 4.7"/></svg>
          Team
        </a>
        <% } %>
      </nav>
      <div class="admin-sidebar-footer">
        <a href="/" target="_blank" rel="noopener">&larr; View public site</a>
      </div>
    </aside>
    <div class="admin-main">
      <header class="admin-topbar">
        <button class="nav-toggle" id="sidebarToggle" aria-label="Toggle menu"><span></span><span></span><span></span></button>
        <h1 class="admin-page-title"><%= title %></h1>
        <div class="admin-topbar-user">
          <% if (currentUser) { %>
            <span><%= currentUser.name %> <span class="badge badge-muted"><%= currentUser.role %></span></span>
            <form method="post" action="/admin/logout"><button class="btn btn-ghost btn-sm" type="submit">Sign out</button></form>
          <% } %>
        </div>
      </header>
      <div class="admin-content">
        <%- include('flash') %>
