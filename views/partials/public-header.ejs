<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' && title ? title + ' — ' + settings.siteName : settings.siteName %></title>
  <% if (typeof description !== 'undefined' && description) { %>
  <meta name="description" content="<%= description %>" />
  <% } %>
  <% if (settings.faviconUrl) { %><link rel="icon" href="<%= settings.faviconUrl %>" /><% } %>
  <link rel="stylesheet" href="/css/base.css" />
  <link rel="stylesheet" href="/css/site.css" />
  <style>:root { --brand: <%= settings.primaryColor %>; }</style>
</head>
<body>
  <header class="site-header">
    <div class="container site-header-inner">
      <a class="brand" href="/">
        <% if (settings.logoUrl) { %>
          <img src="<%= settings.logoUrl %>" alt="<%= settings.siteName %>" class="brand-logo" />
        <% } %>
        <span><%= settings.siteName %></span>
      </a>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <nav class="site-nav" id="siteNav">
        <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a>
        <a href="/profiles" class="<%= currentPath.startsWith('/profiles') ? 'active' : '' %>">Talent</a>
        <a href="/contact" class="<%= currentPath === '/contact' ? 'active' : '' %>">Contact</a>
        <a href="/admin" class="nav-admin-link">Admin</a>
      </nav>
    </div>
  </header>
  <main>
    <%- include('flash') %>
