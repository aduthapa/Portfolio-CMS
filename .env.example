# Copy this file to .env and fill in real values. Never commit .env.

# MySQL connection string for Prisma.
# cPanel format is usually: mysql://cpanelUser_dbUser:PASSWORD@localhost:3306/cpanelUser_dbName
DATABASE_URL="mysql://portfolio_user:changeme@localhost:3306/portfolio_cms"

# Port Passenger/cPanel injects at runtime. Locally, pick anything free.
PORT=3000

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# "production" enables secure cookies and disables verbose error pages.
NODE_ENV="development"

# Base URL of the deployed site, used for absolute links (e.g. in emails/SEO tags).
SITE_URL="http://localhost:3000"

# Credentials used ONLY by prisma/seed.ts to create the first admin account.
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Max upload size in megabytes for portfolio media.
MAX_UPLOAD_MB=25

# Email delivery, used to send "forgot password" one-time codes and the
# admin "send test email" button (Settings page). Two options — set ONE:
#
# Option A — Brevo API (recommended on shared hosting): sends over HTTPS
# (port 443), which is never blocked, unlike SMTP ports. Get this from
# Brevo -> SMTP & API -> API Keys (a different value from the SMTP password).
# If set, this takes priority over the SMTP_* settings below.
BREVO_API_KEY=""
#
# Option B — plain SMTP: works anywhere that doesn't block outbound SMTP
# ports (25/465/587). Many cheap shared hosts do block them — if the
# "send test email" button times out, switch to Option A instead.
# SMTP_FROM must be a verified sender in your email provider either way.
SMTP_HOST=""
SMTP_PORT=587
# "true" for port 465 (implicit TLS), "false" for 587/25 (STARTTLS).
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Defaults to SMTP_USER if left blank. Also used as the "sender" for the
# Brevo API path above.
SMTP_FROM=""
