# Copy this file to .env and fill in real values. Never commit .env.

# MySQL connection string for Prisma.
# cPanel format is usually: mysql://cpanelUser_dbUser:PASSWORD@localhost:3306/cpanelUser_dbName
DATABASE_URL="mysql://portfolio_user:changeme@localhost:3306/portfolio_cms"

# Port Passenger/cPanel injects at runtime. Locally, pick anything free.
PORT=3000

# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# "production" enables secure cookies and disables verbose error pages.
NODE_ENV="development"

# Base URL of the deployed site, used for absolute links (e.g. in emails/SEO tags).
SITE_URL="http://localhost:3000"

# Credentials used ONLY by prisma/seed.ts to create the first admin account.
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Max upload size in megabytes for portfolio media.
MAX_UPLOAD_MB=25

# SMTP settings used to send "forgot password" one-time codes.
# Any standard SMTP provider works (your email host, SendGrid, Mailgun, etc).
# If SMTP_HOST is left blank, the forgot-password flow will fail to send mail
# (the request still responds normally to avoid leaking which emails exist).
SMTP_HOST=""
SMTP_PORT=587
# "true" for port 465 (implicit TLS), "false" for 587/25 (STARTTLS).
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Defaults to SMTP_USER if left blank.
SMTP_FROM=""
